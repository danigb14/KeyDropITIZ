# .env.local - Variables de entorno para desarrollo local

# reCAPTCHA v2 site key (obtener de https://www.google.com/recaptcha/admin)
REACT_APP_RECAPTCHA_V2_SITE_KEY=YOUR_RECAPTCHA_V2_SITE_KEY

# Email para envío de verificaciones
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
